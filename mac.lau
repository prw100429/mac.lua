--==================================================
-- CHARACTER
--==================================================

local character
local humanoid
local rootPart

local flyAttachment
local flyVelocity

local function removeFlyPhysics()
	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end

	if flyAttachment then
		flyAttachment:Destroy()
		flyAttachment = nil
	end
end

local function setupCharacter(char)
	removeFlyPhysics()

	character = char

	humanoid =
		char:WaitForChild(
			"Humanoid"
		)

	rootPart =
		char:WaitForChild(
			"HumanoidRootPart"
		)

	flyEnabled = false

	flyButton.Text = "FLY  OFF"
	flyButton.TextColor3 = C.Red
	flyButton.BackgroundColor3 = C.Button
end

if player.Character then
	task.spawn(
		setupCharacter,
		player.Character
	)
end

player.CharacterAdded:Connect(
	setupCharacter
)

--==================================================
-- FLY PHYSICS
--==================================================

local function createFlyPhysics()
	if not rootPart then
		return
	end

	removeFlyPhysics()

	flyAttachment =
		Instance.new("Attachment")

	flyAttachment.Name =
		"CleanFlyAttachment"

	flyAttachment.Parent =
		rootPart

	flyVelocity =
		Instance.new("LinearVelocity")

	flyVelocity.Name =
		"CleanFlyVelocity"

	flyVelocity.Attachment0 =
		flyAttachment

	flyVelocity.RelativeTo =
		Enum.ActuatorRelativeTo.World

	flyVelocity.VelocityConstraintMode =
		Enum.VelocityConstraintMode.Vector

	flyVelocity.VectorVelocity =
		Vector3.zero

	flyVelocity.MaxForce =
		math.huge

	flyVelocity.Parent =
		rootPart
end

--==================================================
-- FLY TOGGLE
--==================================================

local function toggleFly()
	if not rootPart
		or not rootPart.Parent
	then
		return
	end

	flyEnabled =
		not flyEnabled

	if flyEnabled then
		createFlyPhysics()

		flyButton.Text =
			"FLY  ON"

		flyButton.TextColor3 =
			C.Green

		flyButton.BackgroundColor3 =
			Color3.fromRGB(
				34,
				65,
				52
			)

	else
		removeFlyPhysics()

		flyButton.Text =
			"FLY  OFF"

		flyButton.TextColor3 =
			C.Red

		flyButton.BackgroundColor3 =
			C.Button
	end
end

flyButton.MouseButton1Click:Connect(
	toggleFly
)

--==================================================
-- MOVEMENT
--==================================================

local movement = {
	W = false,
	A = false,
	S = false,
	D = false,
	Up = false,
	Down = false
}

local function setMovement(
	keyCode,
	state
)

	if keyCode == Enum.KeyCode.W then
		movement.W = state

	elseif keyCode == Enum.KeyCode.S then
		movement.S = state

	elseif keyCode == Enum.KeyCode.A then
		movement.A = state

	elseif keyCode == Enum.KeyCode.D then
		movement.D = state

	elseif keyCode == Enum.KeyCode.Space then
		movement.Up = state

	elseif keyCode == Enum.KeyCode.LeftControl then
		movement.Down = state
	end
end

--==================================================
-- INPUT
--==================================================

UserInputService.InputBegan:Connect(function(
	input,
	gameProcessed
)

	--------------------------------------------------
	-- UI KEY CHANGE
	--------------------------------------------------

	if waitingForUIToggleKey then
		if input.UserInputType
			== Enum.UserInputType.Keyboard
		then
			if input.KeyCode
				== Enum.KeyCode.Escape
			then
				waitingForUIToggleKey =
					false

				updateUIKeyButton()

				return
			end

			if input.KeyCode
				~= Enum.KeyCode.Unknown
			then
				uiToggleKey =
					input.KeyCode

				waitingForUIToggleKey =
					false

				updateUIKeyButton()

				return
			end
		end

		return
	end

	--------------------------------------------------
	-- FLY KEY CHANGE
	--------------------------------------------------

	if waitingForFlyToggleKey then
		if input.UserInputType
			== Enum.UserInputType.Keyboard
		then
			if input.KeyCode
				== Enum.KeyCode.Escape
			then
				waitingForFlyToggleKey =
					false

				updateFlyKeyButton()

				return
			end

			if input.KeyCode
				~= Enum.KeyCode.Unknown
			then
				flyToggleKey =
					input.KeyCode

				waitingForFlyToggleKey =
					false

				updateFlyKeyButton()

				return
			end
		end

		return
	end

	--------------------------------------------------
	-- UI TOGGLE
	--------------------------------------------------

	if input.KeyCode == uiToggleKey then
		uiVisible =
			not uiVisible

		main.Visible =
			uiVisible

		return
	end

	--------------------------------------------------
	-- FLY TOGGLE
	--------------------------------------------------

	if input.KeyCode == flyToggleKey then
		toggleFly()
		return
	end

	--------------------------------------------------
	-- MOVEMENT
	--------------------------------------------------

	if not gameProcessed then
		setMovement(
			input.KeyCode,
			true
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	setMovement(
		input.KeyCode,
		false
	)
end)

--==================================================
-- FLY UPDATE
--
-- LinearVelocity가 VectorVelocity = 0 을 유지하므로
-- 아무 키도 안 누르면 중력으로 떨어지지 않음.
--
-- W/S는 카메라 LookVector 그대로 사용해서
-- Y축까지 포함.
--==================================================

RunService.RenderStepped:Connect(function()
	if not flyEnabled then
		return
	end

	if not rootPart
		or not rootPart.Parent
		or not humanoid
		or humanoid.Health <= 0
	then
		return
	end

	if not flyVelocity
		or not flyVelocity.Parent
	then
		createFlyPhysics()
	end

	if not flyVelocity then
		return
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	local forward =
		camera.CFrame.LookVector

	local right =
		camera.CFrame.RightVector

	local direction =
		Vector3.zero

	-- 카메라가 보는 3D 방향 그대로
	if movement.W then
		direction += forward
	end

	if movement.S then
		direction -= forward
	end

	-- 카메라 기준 좌우
	if movement.D then
		direction += right
	end

	if movement.A then
		direction -= right
	end

	-- 수직 이동
	if movement.Up then
		direction += Vector3.yAxis
	end

	if movement.Down then
		direction -= Vector3.yAxis
	end

	if direction.Magnitude > 0 then
		flyVelocity.VectorVelocity =
			direction.Unit
			* flySpeed
	else
		-- ★ 핵심:
		-- 아무 키도 안 누르면 속도 0을
		-- 물리적으로 계속 유지해서 공중 정지
		flyVelocity.VectorVelocity =
			Vector3.zero
	end
end)

--==================================================
-- MACRO
--==================================================

task.spawn(function()
	while true do
		for _, keyData in ipairs(keys) do
			if keyData.Enabled then

				VirtualInputManager:SendKeyEvent(
					true,
					keyData.KeyCode,
					false,
					game
				)

				task.wait(
					keyData.HoldTime
				)

				VirtualInputManager:SendKeyEvent(
					false,
					keyData.KeyCode,
					false,
					game
				)

				task.wait(0.06)
			end
		end

		task.wait(0.15)
	end
end)
