		UDim2.fromOffset(70, 30)
	)

	button.TextColor3 = C.Red

	local timeLabel = makeLabel(
		macroCard,
		"0.5s",
		UDim2.fromOffset(88, y),
		UDim2.fromOffset(42, 30),
		11
	)

	button.MouseButton1Click:Connect(function()
		keyData.Enabled = not keyData.Enabled

		if keyData.Enabled then
			button.Text = keyData.Name .. "  ON"
			button.TextColor3 = C.Green

			button.BackgroundColor3 =
				Color3.fromRGB(
					34,
					65,
					49
				)
		else
			button.Text = keyData.Name .. "  OFF"
			button.TextColor3 = C.Red
			button.BackgroundColor3 = C.Button
		end
	end)

	createSlider(
