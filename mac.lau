--==================================================
-- 반응형 UI 설정
--
-- 화면이 작아질수록 자동 축소
-- 화면이 커져도 기본 크기 이상으로는 커지지 않음
--==================================================

local MIN_UI_SCALE = 0.55
local MAX_UI_SCALE = 1.00

-- 이 화면 크기에서 UI가 100% 크기
local REFERENCE_WIDTH = 1200
local REFERENCE_HEIGHT = 760

