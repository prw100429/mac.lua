--==================================================
-- UI DRAG
--==================================================

local dragging = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)

	if input.UserInputType
			== Enum.UserInputType.MouseButton1
		or input.UserInputType
			== Enum.UserInputType.Touch
	then

		dragging = true

		dragStart =
			UserInputService:GetMouseLocation()

		startPosition =
			main.Position
	end

end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType
			~= Enum.UserInputType.MouseMovement
		and input.UserInputType
			~= Enum.UserInputType.Touch
	then
		return
	end

	local current =
		UserInputService:GetMouseLocation()

	local delta =
		current - dragStart

	main.Position =
		UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,

			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)

end)

UserInputService.InputEnded:Connect(function(input)

	if input.UserInputType
			== Enum.UserInputType.MouseButton1
		or input.UserInputType
			== Enum.UserInputType.Touch
	then

		dragging = false
	end

end)

--==================================================
-- SLIDER SYSTEM
--==================================================

local activeSlider = nil

local function createSlider(
	parent,
	position,
	width,
	minValue,
	maxValue,
	initialValue,
	callback
)

	local slider =
		Instance.new("Frame")

	slider.Position =
		position

	slider.Size =
		UDim2.fromOffset(
			width,
			6
		)

	slider.BackgroundColor3 =
		C.Slider

	slider.BorderSizePixel =
		0

	slider.Parent =
		parent

	round(
		slider,
		10
	)

	local ratio =
		math.clamp(
			(initialValue - minValue)
				/
				(maxValue - minValue),
			0,
			1
		)

	local fill =
		Instance.new("Frame")

	fill.Size =
		UDim2.new(
			ratio,
			0,
			1,
			0
		)

	fill.BackgroundColor3 =
		C.Blue

	fill.BorderSizePixel =
		0

	fill.Parent =
		slider

	round(
		fill,
		10
	)

	local knob =
		Instance.new("TextButton")

	knob.Size =
		UDim2.fromOffset(
			14,
			14
		)

	knob.Position =
		UDim2.new(
			ratio,
			-7,
			0.5,
			-7
		)

	knob.BackgroundColor3 =
		C.White

	knob.BorderSizePixel =
		0

	knob.Text =
		""

	knob.AutoButtonColor =
		false

	knob.Parent =
		slider

	round(
		knob,
		10
	)

	local function update(x)

		if slider.AbsoluteSize.X <= 0 then
			return
		end

		local ratioValue =
			math.clamp(
				(
					x
					-
					slider.AbsolutePosition.X
				)
				/
				slider.AbsoluteSize.X,
				0,
				1
			)

		fill.Size =
			UDim2.new(
				ratioValue,
				0,
				1,
				0
			)

		knob.Position =
			UDim2.new(
				ratioValue,
				-7,
				0.5,
				-7
			)

		local value =
			minValue
			+
			(maxValue - minValue)
			* ratioValue

		callback(
			value
		)

	end

	local function begin(input)

		if input.UserInputType
				== Enum.UserInputType.MouseButton1
			or input.UserInputType
				== Enum.UserInputType.Touch
		then

			activeSlider =
				update

			update(
				input.Position.X
			)
		end

	end

	knob.InputBegan:Connect(
		begin
	)

	slider.InputBegan:Connect(
		begin
	)

	return slider

end

UserInputService.InputChanged:Connect(function(input)

	if not activeSlider then
		return
	end

	if input.UserInputType
			== Enum.UserInputType.MouseMovement
		or input.UserInputType
			== Enum.UserInputType.Touch
	then

		activeSlider(
			input.Position.X
		)

	end

end)

UserInputService.InputEnded:Connect(function(input)

	if input.UserInputType
			== Enum.UserInputType.MouseButton1
		or input.UserInputType
			== Enum.UserInputType.Touch
	then

		activeSlider =
			nil

	end

end)

