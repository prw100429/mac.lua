--==================================================
-- CHARACTER / FLY PHYSICS
--==================================================

local character
local humanoid
local rootPart

local flyAttachment
local flyVelocity

local function removeFlyPhysics()

	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end

	if flyAttachment then
		flyAttachment:Destroy()
		flyAttachment = nil
	end

	-- 이전 실행에서 남아있을 경우 정리
	if rootPart then

		local oldVelocity =
			rootPart:FindFirstChild(
				"CleanFlyVelocity"
			)

		if oldVelocity then
			oldVelocity:Destroy()
		end

		local oldAttachment =
			rootPart:FindFirstChild(
				"CleanFlyAttachment"
			)

		if oldAttachment then
			oldAttachment:Destroy()
		end

	end

end

local function setupCharacter(char)

	removeFlyPhysics()

	character =
		char

	humanoid =
		char:WaitForChild(
			"Humanoid"
		)

	rootPart =
		char:WaitForChild(
			"HumanoidRootPart"
		)

	-- 이전 실행 잔여물 제거
	local oldVelocity =
		rootPart:FindFirstChild(
			"CleanFlyVelocity"
		)

	if oldVelocity then
		oldVelocity:Destroy()
	end

	local oldAttachment =
		rootPart:FindFirstChild(
			"CleanFlyAttachment"
		)

	if oldAttachment then
		oldAttachment:Destroy()
	end

	flyEnabled =
		false

	flyButton.Text =
		"FLY  OFF"

	flyButton.TextColor3 =
		C.Red

	flyButton.BackgroundColor3 =
		C.Button

end

if player.Character then

	task.spawn(
		setupCharacter,
		player.Character
	)

end

player.CharacterAdded:Connect(
	setupCharacter
)

local function createFlyPhysics()

	if not rootPart then
		return
	end

	removeFlyPhysics()

	flyAttachment =
		Instance.new(
			"Attachment"
		)

	flyAttachment.Name =
		"CleanFlyAttachment"

	flyAttachment.Parent =
		rootPart

	flyVelocity =
		Instance.new(
			"LinearVelocity"
		)

	flyVelocity.Name =
		"CleanFlyVelocity"

	flyVelocity.Attachment0 =
		flyAttachment

	flyVelocity.RelativeTo =
		Enum.ActuatorRelativeTo.World

	flyVelocity.VelocityConstraintMode =
		Enum.VelocityConstraintMode.Vector

	flyVelocity.VectorVelocity =
		Vector3.zero

	flyVelocity.MaxForce =
		math.huge

	flyVelocity.Parent =
		rootPart

end

--==================================================
-- FLY TOGGLE
--==================================================

local function toggleFly()

	if not rootPart
		or not rootPart.Parent
	then
		return
	end

	flyEnabled =
		not flyEnabled

	if flyEnabled then

		createFlyPhysics()

		flyButton.Text =
			"FLY  ON"

		flyButton.TextColor3 =
			C.Green

		flyButton.BackgroundColor3 =
			Color3.fromRGB(
				34,
				65,
				52
			)

	else

		removeFlyPhysics()

		flyButton.Text =
			"FLY  OFF"

		flyButton.TextColor3 =
			C.Red

		flyButton.BackgroundColor3 =
			C.Button

	end

end

flyButton.MouseButton1Click:Connect(
	toggleFly
)

--==================================================
-- MOVEMENT STATE
--==================================================

local movement = {
	W = false,
	A = false,
	S = false,
	D = false,

	Up = false,
	Down = false
}

local function setMovement(
	keyCode,
	state
)

	if keyCode
		== Enum.KeyCode.W
	then

		movement.W =
			state

	elseif keyCode
		== Enum.KeyCode.S
	then

		movement.S =
			state

	elseif keyCode
		== Enum.KeyCode.A
	then

		movement.A =
			state

	elseif keyCode
		== Enum.KeyCode.D
	then

		movement.D =
			state

	elseif keyCode
		== Enum.KeyCode.Space
	then

		movement.Up =
			state

	elseif keyCode
		== Enum.KeyCode.LeftControl
	then

		movement.Down =
			state

	end

end

--==================================================
-- INPUT
--==================================================

UserInputService.InputBegan:Connect(function(
	input,
	gameProcessed
)

	--------------------------------------------------
	-- UI 키 설정 대기
	--------------------------------------------------

	if waitingForUIToggleKey then

		if input.UserInputType
			== Enum.UserInputType.Keyboard
		then

			if input.KeyCode
				== Enum.KeyCode.Escape
			then

				waitingForUIToggleKey =
					false

				updateUIKeyButton()

				return

			end

			if input.KeyCode
				~= Enum.KeyCode.Unknown
			then

				uiToggleKey =
					input.KeyCode

				waitingForUIToggleKey =
					false

				updateUIKeyButton()

				return

			end

		end

		return

	end

	--------------------------------------------------
	-- Fly 키 설정 대기
	--------------------------------------------------

	if waitingForFlyToggleKey then

		if input.UserInputType
			== Enum.UserInputType.Keyboard
		then

			if input.KeyCode
				== Enum.KeyCode.Escape
			then

				waitingForFlyToggleKey =
					false

				updateFlyKeyButton()

				return

			end

			if input.KeyCode
				~= Enum.KeyCode.Unknown
			then

				flyToggleKey =
					input.KeyCode

				waitingForFlyToggleKey =
					false

				updateFlyKeyButton()

				return

			end

		end

		return

	end

	--------------------------------------------------
	-- UI TOGGLE
	--------------------------------------------------

	if input.KeyCode
		== uiToggleKey
	then

		uiVisible =
			not uiVisible

		main.Visible =
			uiVisible

		return

	end

	--------------------------------------------------
	-- FLY TOGGLE
	--------------------------------------------------

	if input.KeyCode
		== flyToggleKey
	then

		toggleFly()

		return

	end

	--------------------------------------------------
	-- Fly Movement
	--------------------------------------------------

	if not gameProcessed then

		setMovement(
			input.KeyCode,
			true
		)

	end

end)

UserInputService.InputEnded:Connect(function(input)

	setMovement(
		input.KeyCode,
		false
	)

end)

--==================================================
-- FLY UPDATE
--
-- W = 보는 방향 그대로
-- 카메라 Y축도 포함
--
-- 정지 상태에서는 LinearVelocity가
-- Vector3.zero를 유지해서 떨어지지 않음
--==================================================

RunService.RenderStepped:Connect(function()

	if not flyEnabled then
		return
	end

	if not rootPart
		or not rootPart.Parent
		or not humanoid
		or humanoid.Health <= 0
	then
		return
	end

	if not flyVelocity
		or not flyVelocity.Parent
	then

		createFlyPhysics()

	end

	if not flyVelocity then
		return
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	-- Y축 포함 카메라 방향
	local forward =
		camera.CFrame.LookVector

	local right =
		camera.CFrame.RightVector

	local direction =
		Vector3.zero

	-- 앞
	if movement.W then

		direction +=
			forward

	end

	-- 뒤
	if movement.S then

		direction -=
			forward

	end

	-- 오른쪽
	if movement.D then

		direction +=
			right

	end

	-- 왼쪽
	if movement.A then

		direction -=
			right

	end

	-- 수직 위
	if movement.Up then

		direction +=
			Vector3.yAxis

	end

	-- 수직 아래
	if movement.Down then

		direction -=
			Vector3.yAxis

	end

	if direction.Magnitude > 0 then

		flyVelocity.VectorVelocity =
			direction.Unit
			* flySpeed

	else

		-- 공중 정지
		flyVelocity.VectorVelocity =
			Vector3.zero

	end

end)

--==================================================
-- MACRO
--==================================================

task.spawn(function()

	while true do

		for _, keyData
			in ipairs(keys)
		do

			if keyData.Enabled then

				-- Key Down
				VirtualInputManager:SendKeyEvent(
					true,
					keyData.KeyCode,
					false,
					game
				)

				-- Hold
				task.wait(
					keyData.HoldTime
				)

				-- Key Up
				VirtualInputManager:SendKeyEvent(
					false,
					keyData.KeyCode,
					false,
					game
				)

				task.wait(
					0.06
				)

			end

		end

		task.wait(
			0.15
		)

	end

end)
